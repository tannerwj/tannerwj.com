---
import Base from "../layouts/Base.astro";
import { socials } from "../data/links";

const aboutSocials = socials.filter((s) => s.name !== "Goodreads");
---

<Base
  title="About — Tanner Johnson"
  description="Tanner Johnson is a principal engineer in Utah, focused on large-scale security, architecture, and AI orchestration."
  path="/about"
>
  <div class="wrap">
    <header class="page-head">
      <p class="path reveal">~/about</p>
      <h1 class="reveal" data-delay="1">About</h1>
    </header>

    <div class="about-grid" style="padding-bottom: 4rem">
      <div class="prose reveal" data-delay="2">
        <p class="lede" style="color: var(--ink); margin-bottom: 1.5rem">
          I'm Tanner — a principal engineer in Utah.
        </p>
        <p>
          My main thing is <strong>large-scale security, architecture, and AI
          orchestration</strong> — designing systems that hold up for humans
          and agents alike.
        </p>
        <p>
          The smaller stuff — a trading game, a daily comic, a deadpan-serious
          star observatory — are one-off side quests. If an idea is interesting,
          it gets built.
        </p>
        <p style="margin-top: 2rem">
          <a class="btn btn-primary" href="/projects">See the work →</a>
        </p>
      </div>

      <aside class="reveal" data-delay="3">
        <ul class="fact-list">
          <li><span class="k">Name</span><span class="v">Tanner Johnson</span></li>
          <li><span class="k">Based in</span><span class="v">Utah, USA</span></li>
          <li><span class="k">Role</span><span class="v">Principal Engineer</span></li>
          <li><span class="k">Projects</span><span class="v"><a class="text-link" href="/projects">24 and counting →</a></span></li>
          {aboutSocials.map((s) => (
            <li><span class="k">{s.name}</span><span class="v"><a class="text-link" href={s.url} target="_blank" rel="noopener">{s.handle} ↗</a></span></li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</Base>
