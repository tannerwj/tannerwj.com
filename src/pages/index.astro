---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Terminal from "../components/Terminal.astro";
import { featuredProjects, projects } from "../data/projects";

const [p1, p2, p3, p4] = featuredProjects;
const count = projects.length;
---

<Base title="Tanner Johnson — Principal Engineer" path="/">
  <section class="hero wrap">
    <div class="hero-top reveal">
      <span class="status-dot" aria-hidden="true"></span>
      <span>$ whoami — systems operational</span>
    </div>

    <h1 class="display reveal" data-delay="1">
      Tanner<br />Johnson<span style="color: var(--accent)">.</span>
    </h1>

    <div class="hero-sub">
      <p class="lede reveal" data-delay="2">
        Principal engineer — large-scale security, architecture, and AI
        orchestration for <span style="color: var(--ink)">humans and agents</span>.
      </p>
    </div>

    <div class="hero-sub reveal" data-delay="3" style="margin-top: 2.2rem">
      <a class="btn btn-primary" href="/projects">View projects →</a>
      <a class="btn btn-ghost" href="/links">/links</a>
      <span class="hero-meta">~/utah · {count} projects shipped</span>
    </div>
  </section>

  <section class="section wrap" aria-label="Featured projects">
    <div class="section-head reveal">
      <h2><span class="index mono">01 — </span>Featured</h2>
      <a class="text-link" href="/projects">full index →</a>
    </div>

    <div class="bento">
      {p1 && <ProjectCard project={p1} span="span-3" delay={0} />}
      {p2 && <ProjectCard project={p2} span="span-3" delay={1} />}
      {p3 && <ProjectCard project={p3} span="span-2" delay={0} />}
      {p4 && <ProjectCard project={p4} span="span-2" delay={1} />}
      <a class="card span-2 reveal" data-delay="2" href="/projects">
        <span class="card-body">
          <span class="card-top">
            <span class="tags"><span class="tag">{count} total</span></span>
            <span class="arrow" aria-hidden="true">→</span>
          </span>
          <h3>The archive</h3>
          <p>Apps, tools, games, experiments, and sites. The full index, filterable.</p>
          <span class="card-url">
            <span class="status-dot" aria-hidden="true"></span>
            tannerwj.com/projects
          </span>
        </span>
      </a>
    </div>
  </section>

  <section class="section wrap" aria-label="Console">
    <div class="section-head reveal">
      <h2><span class="index mono">02 — </span>Console</h2>
      <span class="index mono">type `help`</span>
    </div>
    <Terminal />
  </section>

  <section class="section wrap" aria-label="More">
    <div class="section-head reveal">
      <h2><span class="index mono">03 — </span>Elsewhere</h2>
    </div>
    <div class="link-group reveal">
      <a class="link-row" href="/now">
        <span class="link-name">/now</span>
        <span class="link-blurb">What I'm focused on lately — broad strokes, updated when it changes.</span>
        <span class="go" aria-hidden="true">→</span>
      </a>
      <a class="link-row" href="/about">
        <span class="link-name">/about</span>
        <span class="link-blurb">Short, human, specific. Who I am and how to reach me.</span>
        <span class="go" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>
