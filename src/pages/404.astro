---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Tanner Johnson" description="Page not found." path="/404" noindex={true}>
  <div class="wrap" style="padding: 6rem 0; text-align: center">
    <p class="mono reveal" style="color: var(--faint)">$ 404 — segment not found</p>
    <h1 class="display reveal" data-delay="1" style="font-size: clamp(4rem, 14vw, 9rem)">404</h1>
    <p class="lede reveal" data-delay="2" style="margin: 1.5rem auto">
      This page doesn't exist. The projects do, though.
    </p>
    <p class="reveal" data-delay="3" style="margin-top: 2rem">
      <a class="btn btn-primary" href="/">← home</a>
    </p>
  </div>
</Base>
