---
import Base from "../layouts/Base.astro";
import { linkGroups } from "../data/links";

// Link-in-bio: the page friends get texted. Big tap targets, full-width rows.
---

<Base
  title="Links"
  description="Tanner Johnson's link-in-bio — referral links and services he actually recommends, most with a perk for you too."
  path="/links"
>
  <div class="wrap">
    <header class="page-head">
      <span class="path">~/links</span>
      <h1>Links</h1>
      <p class="lede">
        Everything I actually recommend. These are referral links — in most
        cases they come with a perk for you too.
      </p>
    </header>

    {linkGroups.map((group) => (
      <section class="link-group" aria-label={group.title}>
        <h2>{group.title}</h2>
        {group.items.map((item) => (
          <a class="link-row" href={item.url} target="_blank" rel="noopener sponsored">
            <span class="link-name">{item.name}</span>
            <span class="link-blurb">{item.blurb}</span>
            {item.perk && <span class="perk">{item.perk}</span>}
            <span class="go" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </section>
    ))}

    <p class="muted">
      Some links are referral links that may earn me credit or a commission at
      no extra cost to you.
    </p>
  </div>
</Base>
